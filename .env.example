# Server-side only — never exposed to the browser.
# The Gemini API key powers text generation and mints short-lived ephemeral
# tokens for the Live voice feature (the browser never sees this key).
GEMINI_API_KEY=your-gemini-api-key

# Optional. Enables the Google Maps Embed API on the "Nearby" page.
# Without it the page falls back to a keyless Google Maps embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
